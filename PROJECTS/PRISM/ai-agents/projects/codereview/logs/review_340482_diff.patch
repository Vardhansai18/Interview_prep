+# Makefile wrapper for keymgmtd unit tests
+# Builds and runs tests natively with system g++
+
+TOPDIR ?= ../../..
+BUILD_DIR := build
+SYS_ROOT := $(TOPDIR)/devfs_x86_64
+
+# GoogleTest paths
+GTEST_DIR := googletest-release-1.11.0
+GTEST_INCL := $(GTEST_DIR)/googletest/include
+GTEST_SRC := $(GTEST_DIR)/googletest/src
+GTEST_ALL := $(BUILD_DIR)/gtest-all.o
+# Note: test_main.cpp provides main(), so we don't need gtest_main.o
+
+# Compiler
+CXX := g++
+CXXFLAGS := -g -fPIC -std=c++11 -Wreturn-type -DBOOST_THREAD_PROVIDES_FUTURE -DOPENSSL_NO_KRB5
+
+# Include paths
+INCLUDES := -I. -I.. -I$(SYS_ROOT)/usr/include -I$(SYS_ROOT)/usr/include/mcp/schema_headers -Ilocal_include/usr/include -I$(GTEST_INCL)
+
+# Source files
+KEYMGMTD_SRCS := \
+	../bigip_keymgmtd_error_defs.cpp \
+	../KeyMgmtDaemon.cpp \
+	../BundleMgr.cpp \
+	../CRLMgr.cpp \
+	../McpdUtil.cpp \
+	../KeyMgmtOpenSSLUtil.cpp \
+	../CertOrderMgr.cpp \
+	../CAReqResp.cpp \
+	../CAReqRespDigicert.cpp \
+	../CAReqRespGodaddy.cpp
+
+TEST_SRCS := \
+	test_main_simple.cpp \
+	ComodoReqRespTest.cpp \
+	SymantecReqRespTest.cpp \
+	DigicertReqRespTest.cpp \
+	GodaddyReqRespTest.cpp \
+	CAReqRespBaseTest.cpp \
+	KmTimeUtilsTest.cpp
+# Excluded tests that depend on missing source files:
+#	JsonUtilTest.cpp (requires ../JsonUtil.cpp which doesn't exist yet)
+#	KeyMgmtOpenSSLUtilTest.cpp (requires KmSignatureUtil, kmTime::iso8601_to_time not implemented yet)
+# Using test_main_simple.cpp instead of test_main.cpp to avoid gcov dependency
+
+# Object files
+KEYMGMTD_OBJS := $(patsubst ../%.cpp,$(BUILD_DIR)/%.o,$(KEYMGMTD_SRCS))
+TEST_OBJS := $(patsubst %.cpp,$(BUILD_DIR)/%.o,$(TEST_SRCS))
+ALL_OBJS := $(KEYMGMTD_OBJS) $(TEST_OBJS)
+
+# Libraries (specify full .so.1.66.0 names for boost since .so symlinks don't exist)
+LIBS := -L$(SYS_ROOT)/usr/lib64 -L/usr/lib64 \
+	-Wl,-rpath,$(SYS_ROOT)/usr/lib64 -Wl,-rpath,/usr/lib64 \
+	-lpthread \
+	-lf5daemon -lmcpmsg -lmcpmsg++ -lcavecommon -lschemadata \
+	-lf5cppcommon -lf5util -lbss -lha_table -lfflag -lerrdefs \
+	-levent -lcrypto -lz -lssl \
+	/usr/lib64/libboost_system.so.1.66.0 \
+	/usr/lib64/libboost_thread.so.1.66.0 \
+	/usr/lib64/libboost_filesystem.so.1.66.0 \
+	/usr/lib64/libboost_iostreams.so.1.66.0 \
+	/usr/lib64/libboost_date_time.so.1.66.0 \
+	-lcurl -lfilemgmt -ltmstat -lf5util_c -lcertmgrutil \
+	-lrt -ldl
+
+# Test executable
+TEST_EXE := $(BUILD_DIR)/keymgmtd_utest
+
+.PHONY: all test unittest coverage clean
+
+all: test
+
+# Build and run unit tests
+test unittest: $(TEST_EXE)
+	@echo "Running keymgmtd unit tests..."
+	cd $(BUILD_DIR) && LD_LIBRARY_PATH=/usr/lib64:$(PWD)/$(SYS_ROOT)/usr/lib:$(PWD)/$(SYS_ROOT)/usr/lib64 ./keymgmtd_utest
+
+# Link test executable (depends on gtest objects)
+$(TEST_EXE): $(ALL_OBJS) $(GTEST_ALL)
+	@mkdir -p $(BUILD_DIR)
+	$(CXX) $(CXXFLAGS) -o $@ $(ALL_OBJS) $(GTEST_ALL) $(LIBS)
+
+# Build gtest-all.o
+$(GTEST_ALL): $(GTEST_DIR)/googletest/src/gtest-all.cc
+	@mkdir -p $(BUILD_DIR)
+	$(CXX) $(CXXFLAGS) -I$(GTEST_INCL) -I$(GTEST_DIR)/googletest -c $< -o $@
+
+# Compile keymgmtd source files
+$(BUILD_DIR)/%.o: ../%.cpp
+	@mkdir -p $(BUILD_DIR)
+	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@
+
+# Compile test source files
+$(BUILD_DIR)/%.o: %.cpp
+	@mkdir -p $(BUILD_DIR)
+	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@
+
+# Coverage target (simplified - just runs tests with coverage flags)
+coverage:
+	$(MAKE) CXXFLAGS="$(CXXFLAGS) -fno-inline -O0 --coverage" LIBS="$(LIBS) --coverage" test
+
+# Clean build artifacts
+clean:
+	rm -rf $(BUILD_DIR)
+
--- //depot/tmos/rocky/tm_daemon/keymgmtd/unittests/test_main_simple.cpp	//depot/tmos/rocky/tm_daemon/keymgmtd/unittests/test_main_simple.cpp#0
