+/**
+ * Unit tests for KeyMgmtOpenSSLUtil.h functions.
+ *
+ * Tests pure/utility functions that do NOT require daemon infrastructure:
+ *   - KmBase64UrlUtils::toBase64url / fromBase64Url
+ *   - KmHashUtil::sha256
+ *   - KmSignatureUtil::getHmacSignature
+ *   - kmTime::iso8601_to_time
+ *   - kmTime::asn1_time_to_sec
+ *   - kmTime::get_current_time
+ */
+
+#include <gtest/gtest.h>
+#include <string>
+#include <cstring>
+#include <ctime>
+
+#include <boost/shared_ptr.hpp>
+
+extern "C" {
+#include <openssl/ssl.h>
+#include <openssl/evp.h>
+#include <openssl/bio.h>
+#include <openssl/x509.h>
+}
+
+#include "../KeyMgmtOpenSSLUtil.h"
+
+// ===========================================================================
+// KmBase64UrlUtils tests
+// ===========================================================================
+
+TEST(Base64UrlTest, EncodeSimpleString)
+{
+    std::string encoded = KmBase64UrlUtils::toBase64url("Hello, World!");
+    ASSERT_FALSE(encoded.empty());
+    // Standard base64 of "Hello, World!" is "SGVsbG8sIFdvcmxkIQ=="
+    // Base64url strips '=' and replaces +/ with -_
+    ASSERT_EQ(encoded.find('='), std::string::npos);
+    ASSERT_EQ(encoded.find('+'), std::string::npos);
+    ASSERT_EQ(encoded.find('/'), std::string::npos);
+}
+
+TEST(Base64UrlTest, RoundTrip)
+{
+    std::string input = "Hello, World!";
+    std::string encoded = KmBase64UrlUtils::toBase64url(input);
+    std::string decoded = KmBase64UrlUtils::fromBase64Url(encoded);
+    ASSERT_EQ(input, decoded);
+}
+
+TEST(Base64UrlTest, RoundTripBinaryData)
+{
+    // Binary data with all byte values 0-255
+    std::string input;
+    for (int i = 0; i < 256; i++) {
+        input += static_cast<char>(i);
+    }
+    std::string encoded = KmBase64UrlUtils::toBase64url(input);
+    std::string decoded = KmBase64UrlUtils::fromBase64Url(encoded);
+    ASSERT_EQ(input, decoded);
+}
+
+TEST(Base64UrlTest, EmptyInput)
+{
+    std::string encoded = KmBase64UrlUtils::toBase64url("");
+    std::string decoded = KmBase64UrlUtils::fromBase64Url(encoded);
+    ASSERT_TRUE(decoded.empty());
+}
+
+TEST(Base64UrlTest, SingleChar)
+{
+    std::string input = "A";
+    std::string encoded = KmBase64UrlUtils::toBase64url(input);
+    ASSERT_FALSE(encoded.empty());
+    std::string decoded = KmBase64UrlUtils::fromBase64Url(encoded);
+    ASSERT_EQ(input, decoded);
+}
+
+TEST(Base64UrlTest, PaddingVariants)
+{
+    // Input length 1 (needs 2 padding '=')
+    ASSERT_EQ("a", KmBase64UrlUtils::fromBase64Url(
+                        KmBase64UrlUtils::toBase64url("a")));
+    // Input length 2 (needs 1 padding '=')
+    ASSERT_EQ("ab", KmBase64UrlUtils::fromBase64Url(
+                        KmBase64UrlUtils::toBase64url("ab")));
+    // Input length 3 (no padding)
+    ASSERT_EQ("abc", KmBase64UrlUtils::fromBase64Url(
+                        KmBase64UrlUtils::toBase64url("abc")));
+}
+
+TEST(Base64UrlTest, SpecialBase64Characters)
+{
+    // Input that produces + and / in standard base64
+    // The bytes 0xfb, 0xff, 0xfe produce "u//+" in standard base64
+    std::string input("\xfb\xff\xfe", 3);
+    std::string encoded = KmBase64UrlUtils::toBase64url(input);
+    // Must use - instead of + and _ instead of /
+    ASSERT_EQ(encoded.find('+'), std::string::npos);
+    ASSERT_EQ(encoded.find('/'), std::string::npos);
+    // Round-trip must succeed
+    ASSERT_EQ(input, KmBase64UrlUtils::fromBase64Url(encoded));
+}
+
+TEST(Base64UrlTest, DecodeInvalidInput)
+{
+    // Completely invalid base64 should return empty or not crash
+    std::string result = KmBase64UrlUtils::fromBase64Url("!!!invalid!!!");
+    // Just verify it doesn't crash; result may be empty or garbage
+    (void)result;
+}
+
+// ===========================================================================
+// KmHashUtil tests
+// ===========================================================================
+
+TEST(Sha256Test, KnownVector)
+{
+    // SHA-256("abc") = ba7816bf 8f01cfea 414140de 5dae2223
+    //                  b00361a3 96177a9c b410ff61 f20015ad
+    std::string hash = KmHashUtil::sha256("abc");
+    ASSERT_EQ(hash.size(), 32u);
+
+    // Check first 4 bytes
+    ASSERT_EQ(static_cast<unsigned char>(hash[0]), 0xba);
+    ASSERT_EQ(static_cast<unsigned char>(hash[1]), 0x78);
+    ASSERT_EQ(static_cast<unsigned char>(hash[2]), 0x16);
+    ASSERT_EQ(static_cast<unsigned char>(hash[3]), 0xbf);
+}
+
+TEST(Sha256Test, EmptyString)
+{
+    // SHA-256("") = e3b0c44298fc1c149afbf4c8996fb924
+    //               27ae41e4649b934ca495991b7852b855
+    std::string hash = KmHashUtil::sha256("");
+    ASSERT_EQ(hash.size(), 32u);
+
+    ASSERT_EQ(static_cast<unsigned char>(hash[0]), 0xe3);
+    ASSERT_EQ(static_cast<unsigned char>(hash[1]), 0xb0);
+    ASSERT_EQ(static_cast<unsigned char>(hash[2]), 0xc4);
+    ASSERT_EQ(static_cast<unsigned char>(hash[3]), 0x42);
+}
+
+TEST(Sha256Test, DeterministicOutput)
+{
+    std::string hash1 = KmHashUtil::sha256("test data");
+    std::string hash2 = KmHashUtil::sha256("test data");
+    ASSERT_EQ(hash1, hash2);
+}
+
+TEST(Sha256Test, DifferentInputsDifferentHashes)
+{
+    std::string hash1 = KmHashUtil::sha256("data1");
+    std::string hash2 = KmHashUtil::sha256("data2");
+    ASSERT_NE(hash1, hash2);
+}
+
+// ===========================================================================
+// KmSignatureUtil tests (HMAC)
+// ===========================================================================
+
+TEST(HmacTest, HS256NonEmpty)
+{
+    std::string sig = KmSignatureUtil::getHmacSignature(KM_HS256, "key", "data");
+    ASSERT_FALSE(sig.empty());
+    ASSERT_EQ(sig.size(), 32u);  // SHA-256 produces 32 bytes
+}
+
+TEST(HmacTest, HS384NonEmpty)
+{
+    std::string sig = KmSignatureUtil::getHmacSignature(KM_HS384, "key", "data");
+    ASSERT_FALSE(sig.empty());
+    ASSERT_EQ(sig.size(), 48u);  // SHA-384 produces 48 bytes
+}
+
+TEST(HmacTest, HS512NonEmpty)
+{
+    std::string sig = KmSignatureUtil::getHmacSignature(KM_HS512, "key", "data");
+    ASSERT_FALSE(sig.empty());
+    ASSERT_EQ(sig.size(), 64u);  // SHA-512 produces 64 bytes
+}
+
+TEST(HmacTest, HS256KnownVector)
+{
+    // HMAC-SHA256(key="key", data="The quick brown fox jumps over the lazy dog")
+    // = f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8
+    std::string sig = KmSignatureUtil::getHmacSignature(KM_HS256, "key",
+            "The quick brown fox jumps over the lazy dog");
+    ASSERT_EQ(sig.size(), 32u);
+    ASSERT_EQ(static_cast<unsigned char>(sig[0]), 0xf7);
+    ASSERT_EQ(static_cast<unsigned char>(sig[1]), 0xbc);
+    ASSERT_EQ(static_cast<unsigned char>(sig[2]), 0x83);
+    ASSERT_EQ(static_cast<unsigned char>(sig[3]), 0xf4);
+}
+
+TEST(HmacTest, DeterministicOutput)
+{
+    std::string sig1 = KmSignatureUtil::getHmacSignature(KM_HS256, "secret", "msg");
+    std::string sig2 = KmSignatureUtil::getHmacSignature(KM_HS256, "secret", "msg");
+    ASSERT_EQ(sig1, sig2);
+}
+
+TEST(HmacTest, DifferentKeysDifferentSigs)
+{
+    std::string sig1 = KmSignatureUtil::getHmacSignature(KM_HS256, "key1", "data");
+    std::string sig2 = KmSignatureUtil::getHmacSignature(KM_HS256, "key2", "data");
+    ASSERT_NE(sig1, sig2);
+}
+
+TEST(HmacTest, DifferentDataDifferentSigs)
+{
+    std::string sig1 = KmSignatureUtil::getHmacSignature(KM_HS256, "key", "data1");
+    std::string sig2 = KmSignatureUtil::getHmacSignature(KM_HS256, "key", "data2");
+    ASSERT_NE(sig1, sig2);
+}
+
+TEST(HmacTest, EmptyKeyAndData)
+{
+    std::string sig = KmSignatureUtil::getHmacSignature(KM_HS256, "", "");
+    ASSERT_FALSE(sig.empty());
+    ASSERT_EQ(sig.size(), 32u);
+}
+
+// ===========================================================================
+// kmTime tests
+// ===========================================================================
+
+TEST(Iso8601Test, ValidTimestampWithZ)
+{
+    // 2024-01-15T12:30:00Z -> epoch value
+    uint64_t t = kmTime::iso8601_to_time("2024-01-15T12:30:00Z");
+    ASSERT_GT(t, 0u);
+    // Verify approximate epoch: Jan 15 2024 = ~1705300200
+    ASSERT_GT(t, 1705000000u);
+    ASSERT_LT(t, 1706000000u);
+}
+
+TEST(Iso8601Test, ValidTimestampWithoutZ)
+{
+    uint64_t t = kmTime::iso8601_to_time("2024-01-15T12:30:00");
+    ASSERT_GT(t, 0u);
+}
+
+TEST(Iso8601Test, EpochTime)
+{
+    // 1970-01-01T00:00:00Z = 0
+    uint64_t t = kmTime::iso8601_to_time("1970-01-01T00:00:00Z");
+    ASSERT_EQ(t, 0u);
+}
+
+TEST(Iso8601Test, InvalidFormat)
+{
+    ASSERT_EQ(kmTime::iso8601_to_time("not-a-date"), 0u);
+}
+
+TEST(Iso8601Test, EmptyString)
+{
+    ASSERT_EQ(kmTime::iso8601_to_time(""), 0u);
+}
+
+TEST(Iso8601Test, SpecificKnownEpoch)
+{
+    // 2000-01-01T00:00:00Z = 946684800
+    uint64_t t = kmTime::iso8601_to_time("2000-01-01T00:00:00Z");
+    ASSERT_EQ(t, 946684800u);
+}
+
+TEST(Asn1TimeTest, UTCTimeFormat)
+{
+    // "240115123000Z" -> Jan 15, 2024 12:30:00 UTC
+    const unsigned char data[] = "240115123000Z";
+    uint64_t seconds = 0;
+    kmTime::asn1_time_to_sec(data, sizeof(data) - 1, true, &seconds);
+    ASSERT_GT(seconds, 0u);
+    // Rough check: Jan 2024 epoch range
+    ASSERT_GT(seconds, 1705000000u);
+    ASSERT_LT(seconds, 1706000000u);
+}
+
+TEST(Asn1TimeTest, GeneralizedTimeFormat)
+{
+    // "20240115123000Z" -> Jan 15, 2024 12:30:00 UTC
+    const unsigned char data[] = "20240115123000Z";
+    uint64_t seconds = 0;
+    kmTime::asn1_time_to_sec(data, sizeof(data) - 1, false, &seconds);
+    ASSERT_GT(seconds, 0u);
+    ASSERT_GT(seconds, 1705000000u);
+    ASSERT_LT(seconds, 1706000000u);
+}
+
+TEST(Asn1TimeTest, UTCTimeY2KBoundary)
+{
+    // "000101000000Z" -> Jan 1, 2000 00:00:00 UTC
+    // Year 00 => 2000 (< 50 so +100 => 100 + 1900 = 2000)
+    const unsigned char data[] = "000101000000Z";
+    uint64_t seconds = 0;
+    kmTime::asn1_time_to_sec(data, sizeof(data) - 1, true, &seconds);
+    // 2000-01-01 = epoch 946684800
+    ASSERT_EQ(seconds, 946684800u);
+}
+
+TEST(Asn1TimeTest, UTCTimePre2000)
+{
+    // "990101000000Z" -> Jan 1, 1999 00:00:00 UTC
+    // Year 99 => 99 (>= 50 so stays 99; 99 + 1900 = 1999)
+    const unsigned char data[] = "990101000000Z";
+    uint64_t seconds = 0;
+    kmTime::asn1_time_to_sec(data, sizeof(data) - 1, true, &seconds);
+    // 1999-01-01 = epoch 915148800
+    ASSERT_EQ(seconds, 915148800u);
+}
+
+TEST(Asn1TimeTest, UTCTimeTooShort)
+{
+    // Less than 10 digits — should not modify seconds
+    const unsigned char data[] = "240115";
+    uint64_t seconds = 0;
+    kmTime::asn1_time_to_sec(data, sizeof(data) - 1, true, &seconds);
+    ASSERT_EQ(seconds, 0u);
+}
+
+TEST(Asn1TimeTest, GeneralizedTimeTooShort)
+{
+    // Less than 12 digits — should not modify seconds
+    const unsigned char data[] = "2024011512";
+    uint64_t seconds = 0;
+    kmTime::asn1_time_to_sec(data, sizeof(data) - 1, false, &seconds);
+    ASSERT_EQ(seconds, 0u);
+}
+
+TEST(Asn1TimeTest, UTCTimeInvalidChars)
+{
+    const unsigned char data[] = "24XX15123000Z";
+    uint64_t seconds = 0;
+    kmTime::asn1_time_to_sec(data, sizeof(data) - 1, true, &seconds);
+    ASSERT_EQ(seconds, 0u);
+}
+
+TEST(GetCurrentTimeTest, ReturnsNonZero)
+{
+    uint64_t t = kmTime::get_current_time();
+    ASSERT_GT(t, 0u);
+    // Should be after Jan 1, 2020
+    ASSERT_GT(t, 1577836800u);
+}
--- //depot/tmos/rocky/tm_daemon/keymgmtd/unittests/Makefile	//depot/tmos/rocky/tm_daemon/keymgmtd/unittests/Makefile#0
